* { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --bg: #0a0e17;
  --surface: #131a2b;
  --border: #1e2a42;
  --text: #e0e6f0;
  --text-dim: #7a8ba8;
  --accent: __ACCENT__;
  --accent-dim: __ACCENT_DIM__;
  --green: #22c55e;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }

/* Nav */
.navbar {
  border-bottom: 1px solid var(--border);
  padding: 1rem 0;
  position: sticky;
  top: 0;
  background: rgba(10, 14, 23, 0.92);
  backdrop-filter: blur(12px);
  z-index: 10;
}

.nav-inner {
  max-width: 1080px;
  margin: 0 auto;
  padding: 0 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text);
  text-decoration: none;
}
.logo span { color: var(--accent); }

.nav-links {
  display: flex;
  gap: 1.5rem;
}
.nav-links a {
  color: var(--text-dim);
  font-size: 0.9rem;
  text-decoration: none;
}
.nav-links a:hover { color: var(--text); }

/* Hero */
.hero {
  max-width: 1080px;
  margin: 0 auto;
  padding: 5rem 1.5rem 4rem;
  text-align: center;
}
.hero h1 {
  font-size: 3rem;
  font-weight: 700;
  letter-spacing: -0.03em;
  margin-bottom: 1rem;
  background: linear-gradient(135deg, #e0e6f0, __ACCENT__);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.hero p {
  font-size: 1.15rem;
  color: var(--text-dim);
  max-width: 560px;
  margin: 0 auto 2rem;
}
.hero-actions {
  display: flex;
  gap: 0.75rem;
  justify-content: center;
}

.btn {
  display: inline-block;
  padding: 0.6rem 1.5rem;
  border-radius: 6px;
  font-size: 0.9rem;
  font-weight: 500;
  text-decoration: none;
  transition: background 0.15s;
}
.btn-primary {
  background: var(--accent);
  color: #fff;
}
.btn-primary:hover { background: __ACCENT_HOVER__; text-decoration: none; }
.btn-secondary {
  background: var(--surface);
  color: var(--text);
  border: 1px solid var(--border);
}
.btn-secondary:hover { background: var(--border); text-decoration: none; }

/* Sections */
section {
  max-width: 1080px;
  margin: 0 auto;
  padding: 4rem 1.5rem;
}
section h2 {
  font-size: 1.5rem;
  font-weight: 600;
  margin-bottom: 2rem;
  text-align: center;
}

/* Status */
.status-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1rem;
  margin-bottom: 1rem;
}
.status-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 1rem 1.25rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.status-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.95rem;
}
.indicator {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}
.indicator.online { background: var(--green); box-shadow: 0 0 6px rgba(34,197,94,0.4); }
.status-label {
  font-size: 0.8rem;
  color: var(--green);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}
.status-updated {
  text-align: center;
  font-size: 0.8rem;
  color: var(--text-dim);
  margin-top: 0.5rem;
}

/* Features */
.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.25rem;
}
.feature {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 1.5rem;
}
.feature-icon {
  font-size: 1.5rem;
  margin-bottom: 0.75rem;
}
.feature h3 {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 0.4rem;
}
.feature p {
  font-size: 0.85rem;
  color: var(--text-dim);
  line-height: 1.5;
}

/* Network */
.stats-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 1rem;
  margin-bottom: 2rem;
}
.stat {
  text-align: center;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 1.25rem;
}
.stat-value {
  display: block;
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--accent);
}
.stat-label {
  display: block;
  font-size: 0.8rem;
  color: var(--text-dim);
  margin-top: 0.25rem;
}

.node-info {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 1.5rem;
  max-width: 480px;
  margin: 0 auto;
}
.node-info h3 {
  font-size: 0.95rem;
  font-weight: 600;
  margin-bottom: 1rem;
}
.node-info table {
  width: 100%;
  border-collapse: collapse;
}
.node-info td {
  padding: 0.4rem 0;
  font-size: 0.85rem;
  border-bottom: 1px solid var(--border);
}
.node-info td:first-child {
  color: var(--text-dim);
  width: 40%;
}
.node-info tr:last-child td { border-bottom: none; }

/* Docs */
.code-block {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 8px;
  overflow: hidden;
  max-width: 640px;
  margin: 0 auto 1rem;
}
.code-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.6rem 1rem;
  border-bottom: 1px solid var(--border);
  font-size: 0.8rem;
  color: var(--text-dim);
}
.copy-btn {
  background: var(--border);
  border: none;
  color: var(--text-dim);
  padding: 0.25rem 0.6rem;
  border-radius: 4px;
  font-size: 0.75rem;
  cursor: pointer;
}
.copy-btn:hover { color: var(--text); }
.code-block pre {
  padding: 1rem;
  overflow-x: auto;
  font-size: 0.82rem;
  line-height: 1.6;
}
.code-block code {
  font-family: "SF Mono", "Fira Code", "Cascadia Code", monospace;
  color: var(--text-dim);
}
.docs-note {
  text-align: center;
  font-size: 0.85rem;
  color: var(--text-dim);
}

/* Footer */
footer {
  border-top: 1px solid var(--border);
  margin-top: 2rem;
}
.footer-inner {
  max-width: 1080px;
  margin: 0 auto;
  padding: 2rem 1.5rem;
  text-align: center;
}
.footer-brand {
  font-size: 1.1rem;
  font-weight: 700;
  margin-bottom: 0.75rem;
}
.footer-brand span { color: var(--accent); }
.footer-links {
  display: flex;
  gap: 1.5rem;
  justify-content: center;
  margin-bottom: 0.75rem;
}
.footer-links a {
  color: var(--text-dim);
  font-size: 0.8rem;
}
.footer-links a:hover { color: var(--text); }
.footer-copy {
  font-size: 0.75rem;
  color: var(--text-dim);
}

@media (max-width: 600px) {
  .hero h1 { font-size: 2rem; }
  .hero { padding: 3rem 1.5rem 2.5rem; }
  .nav-links { display: none; }
  .stats-row { grid-template-columns: repeat(2, 1fr); }
}
