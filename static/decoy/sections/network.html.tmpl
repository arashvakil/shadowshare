    <section id="network" class="network-section">
      <h2>__H_NETWORK__</h2>
      <div class="stats-row">
        <div class="stat">
          <span class="stat-value">__LOCATIONS__</span>
          <span class="stat-label">Edge Locations</span>
        </div>
        <div class="stat">
          <span class="stat-value">__UPTIME__</span>
          <span class="stat-label">Uptime SLA</span>
        </div>
        <div class="stat">
          <span class="stat-value">__CAPACITY__</span>
          <span class="stat-label">Network Capacity</span>
        </div>
        <div class="stat">
          <span class="stat-value">__RPS__</span>
          <span class="stat-label">Requests/sec</span>
        </div>
      </div>
      <div class="node-info">
        <h3>__H_NODE__</h3>
        <table>
          <tr><td>Region</td><td>__REGION__</td></tr>
          <tr><td>Node ID</td><td id="node-id">__NODE__</td></tr>
          <tr><td>Protocol</td><td>HTTP/2, HTTP/3</td></tr>
          <tr><td>Cache</td><td>Warm</td></tr>
          <tr><td>Software</td><td>__BRAND__ Edge v__VERSION__</td></tr>
        </table>
      </div>
    </section>
