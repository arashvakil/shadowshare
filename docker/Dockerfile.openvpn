FROM alpine:3.20

RUN apk add --no-cache \
    openvpn \
    easy-rsa \
    iptables \
    bash \
    ip6tables

# Copy entrypoint from kylemanna/openvpn compatible layout
# Expects /etc/openvpn volume with PKI + config
VOLUME /etc/openvpn
EXPOSE 1194/tcp 1194/udp

CMD ["ovpn_run"]

# Compatibility wrapper matching kylemanna/openvpn behavior
COPY openvpn-entrypoint.sh /usr/local/bin/ovpn_run
RUN chmod +x /usr/local/bin/ovpn_run
