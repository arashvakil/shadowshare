# =============================================================================
# ShadowShare configuration
# Copy to .env and fill in. Everything except TELEGRAM_ID_SALT is optional:
# each protocol turns on only when its variables are set.
# =============================================================================

# --- Core ---------------------------------------------------------------------
# HMAC salt for hashing Telegram IDs (required). Generate: openssl rand -hex 32
TELEGRAM_ID_SALT=
DATABASE_PATH=./data/shadowshare.db
API_PORT=3101
MAX_REFERRALS=10

# Admin panel (min 12 chars; leave empty to disable)
ADMIN_PASSWORD=
ADMIN_PORT=3896
ADMIN_SESSION_SECRET=

# Telegram bot (optional; also enable service.bot in admin settings)
BOT_TOKEN=
BOT_USERNAME=
ADMIN_TELEGRAM_IDS=
MINI_APP_URL=

# --- Server + routing ---------------------------------------------------------
# Public IPv4 of this server. Used in direct-protocol configs and docker-compose port binds.
PUBLIC_SERVER_IP=
# DNS-only hostname pointing at this server (admin/API, Worker relay origin).
# Rewritten to PUBLIC_SERVER_IP inside client configs so it is never exposed.
ORIGIN_HOST=
# CDN host that Marzban writes into its configs, and the CDN-fronted domain clients
# should actually use. If they differ, the subscription pipeline rewrites one to the other.
CDN_SOURCE_DOMAIN=
CDN_CLEAN_DOMAIN=
# Optional second CDN-fronted domain (different zone); CDN outbounds get duplicated onto it.
CDN_BACKUP_DOMAIN=
# Optional Cloudflare Worker relay hostname (see worker-relay/), e.g. relay.<account>.workers.dev
WORKER_RELAY_DOMAIN=
# CDN transport paths. Choose your own; they must match Xray inbounds, Caddyfile and worker-relay.
CDN_WS_PATH=/ws
CDN_HU_PATH=/hu
CDN_GRPC_PATH=/grpc
CDN_XHTTP_PATH=/xh
# TLS SNI cover names used by the Caddy L4 router (must match Xray realitySettings).
REALITY_SNI=
XHTTP_REALITY_SNI=
# Caddy DNS-01 (Cloudflare) for certificates on domains with no A record
CLOUDFLARE_DNS_API_TOKEN=

# --- Marzban (VLESS: Reality, WS/gRPC/XHTTP/HTTPUpgrade via CDN) ---------------
MARZBAN_API_URL=https://marzban:8880
MARZBAN_USERNAME=
MARZBAN_PASSWORD=
MARZBAN_SUB_URL_BASE=

# --- AmneziaWG -----------------------------------------------------------------
AWG_SERVER_IP=
AWG_LISTEN_PORT=51820
AWG_SERVER_ADDRESS=10.8.0.1/24
AWG_DNS=1.1.1.1
AWG_MTU=1280
# AWG 2.0 obfuscation. S1/S2/H1-H4 must match server and client. Keep S3/S4 at 0.
# Pick your own values; don't reuse published ones.
AWG_S1=
AWG_S2=
AWG_S3=0
AWG_S4=0
AWG_H1=
AWG_H2=
AWG_H3=
AWG_H4=
AWG_JC=
AWG_JMIN=
AWG_JMAX=
AWG_I1=
AWG_I2=
AWG_I3=
AWG_I4=
AWG_I5=

# --- sing-box: ShadowTLS v3, Hysteria2, TUIC, Trojan ---------------------------
SHADOWTLS_DOMAIN=
SHADOWTLS_PORT=8444
SHADOWTLS_HANDSHAKE_SERVER=
SHADOWTLS_STRICT_MODE=true
SHADOWTLS_METHOD=2022-blake3-aes-128-gcm
HYSTERIA2_PORT=0
TUIC_PORT=0
TROJAN_PORT=0
# Clean cert domain for direct TLS protocols (DNS-01, no A record)
DIRECT_TLS_DOMAIN=
# L4 SNI multiplexing port advertised to clients (443 when Caddy layer4 is in front)
SNI_ROUTER_PORT=0
# Optional Cloudflare WARP egress for sing-box (hides server IP from destinations).
# Generate with wgcf or warp-cli. Unset = traffic exits directly.
WARP_PRIVATE_KEY=
WARP_ADDRESS_V4=
WARP_ADDRESS_V6=
WARP_RESERVED=

# --- OpenVPN + Cloak -----------------------------------------------------------
OPENVPN_CLOAK_ENABLED=false
SERVER_IP=
CLOAK_PORT=4443
# Site Cloak forwards non-Cloak visitors to. Pick a large site that is reachable where you are.
CLOAK_REDIR_ADDR=www.bing.com

# --- NaiveProxy (server-side only) ---------------------------------------------
NAIVE_PROXY_DOMAIN=
NAIVE_PROXY_QUIC_DOMAIN=
NAIVE_PROXY_QUIC_PORT=37423

# --- DNS tunnels (DNSTT / Slipstream / MasterDnsVPN) ---------------------------
DNSTT_TUNNEL_DOMAIN=
DNSTT_PUBKEY=
DNSTT_SLIPSTREAM_SUBDOMAIN=t2
DNSTT_DNSTT_SUBDOMAIN=d2
DNSTT_SSH_PASSWORD=
DNSTT_XRAY_UUID=
DNSTT_DNS_RELAY_IP=
MASTERDNS_ENCRYPTION_KEY=
MASTERDNS_SUBDOMAIN=m

# --- NPV Tunnel (SSH-direct). Add NPV_SSH_HOST_2..10 for more servers ----------
NPV_SSH_HOST=
NPV_SSH_NAME=
NPV_SSH_PORT=2222
NPV_UDPGW_PORT=7300

# --- SSH tunnel / Mieru --------------------------------------------------------
SSH_TUNNEL_HOST=
SSH_TUNNEL_PORT=2222
SSH_TUNNEL_USER=tunnel
MIERU_SERVER_IP=
MIERU_TCP_PORTS=17261-17264
MIERU_UDP_PORTS=29987-29990

# --- MTProto proxy (Telegram) --------------------------------------------------
# Generate: docker run --rm nineseconds/mtg:2 generate-secret --hex <MTPROTO_FAKETLS_DOMAIN>
MTPROTO_SECRET=
MTPROTO_SERVER=
MTPROTO_FAKETLS_DOMAIN=cloudflare.com

# --- Admin dashboard integrations (optional) -----------------------------------
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=
CLOUDFLARE_ACCOUNT_ID=
HETZNER_API_TOKEN=
