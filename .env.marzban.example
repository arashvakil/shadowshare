# Marzban (VLESS/Xray panel). Copy to .env.marzban.
# Must match MARZBAN_USERNAME / MARZBAN_PASSWORD in .env.
SUDO_USERNAME=admin
SUDO_PASSWORD=
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8880
# Public base for subscription links (same as MARZBAN_SUB_URL_BASE in .env)
XRAY_SUBSCRIPTION_URL_PREFIX=
# Marzban needs a TLS cert for its API: put cert.pem/key.pem in marzban-data/
# (self-signed is fine; ShadowShare talks to it over the Docker network).
