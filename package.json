{
  "name": "shadowshare",
  "version": "1.0.0",
  "description": "Self-hosted, invite-based distribution of censorship-resistant VPN access (web app + Telegram bot)",
  "license": "AGPL-3.0-only",
  "author": "ShadowShare contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/arashvakil/shadowshare.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && vite build",
    "start": "node dist/server.js",
    "webapp:dev": "vite",
